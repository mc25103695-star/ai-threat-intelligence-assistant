# ==============================================
# AI Threat Intelligence Assistant
# Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# ==============================================

# Google Gemini API Key (Free Tier)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Model (change if your account has quota issues with the default)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, etc.
GEMINI_MODEL=gemini-2.5-flash

# VirusTotal API Key (Free Tier)
# Get yours at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key (Free Tier)
# Get yours at: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
